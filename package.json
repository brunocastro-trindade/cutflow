{
  "name": "controlcrm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env.local server/index.js",
    "dev:web": "vite",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "db:reset": "node --env-file-if-exists=.env.local scripts/reset.js",
    "db:migrar-banco": "node --env-file-if-exists=.env.local scripts/migrar-banco.js",
    "db:papel-app": "node --env-file-if-exists=.env.local scripts/papel-app.js",
    "convite": "node --env-file-if-exists=.env.local scripts/convite.js",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.js",
    "ensaiar-migracao": "node --env-file-if-exists=.env.local scripts/ensaiar-migracao.js",
    "isolamento": "node --env-file-if-exists=.env.local scripts/isolamento.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local server/index.js",
    "release": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=22 <25"
  }
}

# Copie este arquivo para .env.local e preencha os valores.
# .env.local está no .gitignore e nunca deve ser comitado.

# ── As DUAS credenciais do banco, e por que são duas ─────────────────────────
#
# A aplicação e a migração usam papéis diferentes, de propósito. O papel da
# aplicação não faz DDL: um vazamento da string que o processo carrega expõe os
# dados, não o projeto. A migração precisa de DDL (db/schema.sql tem 46
# instruções), então usa o papel dono — e só durante o release.
#
# `scripts/migrate.js` escolhe sozinho: usa DATABASE_URL_MIGRACAO quando existe
# e cai para DATABASE_URL quando não. Numa máquina de desenvolvimento com uma
# credencial só, tudo segue funcionando.
#
# Connection string em: Neon Console → seu projeto → Connect.
# Use "Pooled connection" e mantenha o sslmode=require.

# Papel da aplicação (`cutflow_app` em produção, `cutflow_dev_app` no dev):
# lê e escreve nas tabelas, não cria nem apaga nada. Criado por
# `npm run db:papel-app`. É esta que o processo carrega enquanto atende.
DATABASE_URL="postgresql://cutflow_dev_app:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/cutflow_dev?sslmode=require"

# Papel dono (`neondb_owner`): faz DDL. Usada SÓ por `npm run db:migrate` e
# `npm run release`. Deixe em branco se a sua máquina tem uma credencial só.
DATABASE_URL_MIGRACAO="postgresql://neondb_owner:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/cutflow_dev?sslmode=require"

# ATENÇÃO ao banco no fim da string. Na sua máquina as duas apontam para
# `cutflow_dev`, NUNCA para `neondb` (produção). Em 12/08/2026 um servidor
# esquecido com credencial de produção fez contas de teste aparecerem na
# listagem pública do site no ar. O servidor registra host, base e papel na
# primeira linha do log — confira lá quando algo parecer estranho.

# Chave que assina os cookies de sessão. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Trocar esta chave desconecta todo mundo. Mínimo de 32 caracteres.
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria-de-no-minimo-32-caracteres"

# Porta da API local (o Vite faz proxy de /api para cá).
PORT=3001

# Ambiente. Em produção DEVE ser exatamente "production": é o que liga a marca
# `secure` no cookie de sessão (server/auth.js) e o HSTS. Sem isso o cookie
# trafega em HTTP puro. O servidor avisa em voz alta no start quando falta.
NODE_ENV=development

# Quantos proxies reversos existem à frente da API.
# Deixe 0 (ou não defina) em desenvolvimento e quando o Node atende direto:
# aí o rate limit usa o IP real do socket, que ninguém falsifica.
# Atrás de UM proxy (Nginx, Render, Fly, Railway), use 1 — sem isso, todos os
# visitantes chegam com o IP do proxy e compartilham o mesmo limite.
# Nunca aumente "por garantia": cada nível a mais é um X-Forwarded-For a mais
# em que a aplicação passa a acreditar.
TRUST_PROXY=0

